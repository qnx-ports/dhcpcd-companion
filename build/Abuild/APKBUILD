# Alpine-Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=dhcpcd
pkgver=10.2.4
pkgrel=2
pkgdesc="RFC2131 compliant DHCP client"
url="https://roy.marples.name/projects/dhcpcd"
arch="all"
license="BSD-2-Clause"
depends="qnx-io-sock"
makedepends="qnx-io-sock-dev"
#install="$pkgname.pre-install"
subpackages="$pkgname-doc"
source="https://github.com/NetworkConfiguration/dhcpcd/releases/download/v$pkgver/dhcpcd-$pkgver.tar.xz
        fix_qnx.patch
	"

build() {
	echo $HOST $BUILD
	CFLAGS="$CFLAGS -DBSD" \
	./configure \
		--sbindir=/usr/bin \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--libexecdir=/usr/lib/$pkgname \
		--dbdir=/var/lib/$pkgname \
		--rundir=/run/dhcpcd \
		--runstatedir=/run/dhcpcd \
		--disable-static \
		--enable-ipv6 \
		--enable-privsep \
		--enable-seccomp \
		--without-dev \
		--without-udev
	make
}

check() {
	make test
}

package() {
	BINMODE=0755 make DESTDIR="$pkgdir" install
}


